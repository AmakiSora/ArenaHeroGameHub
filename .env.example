# Copy this file to .env on the VPS. Do not commit the populated .env file.

# Required: Arena Hero live API key for the tactic process.
ARENA_HERO_API_KEY=ah_live_replace_with_your_key

# Required: dashboard auth token. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_TOKEN=replace_with_random_token

# Optional: supervisor guards read by docker-entrypoint.py.
# TACTIC_MAX_CRASHES=10      # non-zero tactic exits in 10 min before the container restarts
# TACTIC_STALL_SECONDS=180   # kill+restart tactic when tactic_log.jsonl stops growing
# PLAY_LOG_MAX_MB=20         # rotate tactic_play.log at this size (2 backups kept)
