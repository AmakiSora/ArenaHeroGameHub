# Copy this file to .env on the VPS. Do not commit the populated .env file.

# Required: Arena Hero live API key for the tactic process.
ARENA_HERO_API_KEY=ah_live_replace_with_your_key

# Required: dashboard auth token. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_TOKEN=replace_with_random_token

# Optional
LOG_LEVEL=info
