# Deploy credentials - copy to .env.deploy and fill in
# WARNING: Do not commit .env.deploy to git!

DEPLOY_HOST=your-server-ip
DEPLOY_PORT=22
# Use a dedicated non-root account with docker group access.
# Leaving this empty falls back to "root" and prints a warning at deploy time.
DEPLOY_USER=deploy

DEPLOY_REMOTE_BASE=/srv/arena-game
# Dashboard port inside/behind docker-proxy on the server.
APP_PORT=4399

# --- SSH authentication: pick ONE ------------------------------------------
# Preferred: an SSH key (the password below stays empty).
DEPLOY_KEY_PATH=C:/Users/you/.ssh/arenagame_deploy
# Only if the key is passphrase-protected:
# DEPLOY_KEY_PASSPHRASE=your-key-passphrase

# Password auth still works (and is what we deploy with today); when it is
# non-empty it is used if DEPLOY_KEY_PATH is empty.
DEPLOY_PASSWORD=your-password-here

# --- Host key pinning (OPTIMIZATION_REVIEW.md #4) --------------------------
# Server keys are pinned in deploy/.ssh_known_hosts and anything unknown is
# refused. On the very first deploy from a new machine, trust the server once:
#   PowerShell:  $env:DEPLOY_TRUST_NEW_HOST = "1"
#   bash:        export DEPLOY_TRUST_NEW_HOST=1
# The script prints the server's SHA256 fingerprint before pinning it; verify it
# out-of-band (e.g. `ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub` on the VPS).
# Never commit deploy/.ssh_known_hosts values you did not verify.
# DEPLOY_TRUST_NEW_HOST=1

# --- Secrets written to the remote /srv/arena-game/.env --------------------
# Required for the remote tactic process
ARENA_HERO_API_KEY=ah_live_replace_with_your_key

# Required: dashboard auth token. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_TOKEN=replace_with_random_token
