# Deploy credentials - copy to .env.deploy and fill in
# WARNING: Do not commit .env.deploy to git!

DEPLOY_HOST=your-server-ip
DEPLOY_PORT=22
DEPLOY_USER=root
DEPLOY_PASSWORD=your-password-here
DEPLOY_REMOTE_BASE=/srv/arena-game

# Required for the remote tactic process
ARENA_HERO_API_KEY=ah_live_replace_with_your_key

# Optional
# LOG_LEVEL=info
